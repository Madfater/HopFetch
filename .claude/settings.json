{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "fresh"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git worktree list:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(python3 script/check.py:*)",
      "Bash(python3 script/check_conventions.py:*)",
      "Bash(python3 script/github.py default-branch:*)",
      "Bash(python3 script/github.py pr-view:*)",
      "Bash(python3 script/github.py pr-checks:*)",
      "Bash(python3 script/github.py pr-merged:*)",
      "Bash(python3 script/github.py issue-list:*)",
      "Bash(python3 script/github.py issue-view:*)"
    ],
    "deny": [
      "Read(**/.env.skills)",
      "Edit(**/.env.skills)"
    ]
  }
}
